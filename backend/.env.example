# Copy to .env then load environment variables yourself or use Node --env-file=.env
PORT=4000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4000
DATA_DIR=./data
SESSION_TTL_MINUTES=120
MAX_IMAGE_BYTES=8388608
# Optional for REST writes; NEVER paste a private key in a public GitHub JS script.
API_ACCESS_KEY=
# Optional HTTPS hosts allowed to supply remote images; empty disables URL input.
# Only exact hostnames, no wildcards. For example: storage.googleapis.com
ALLOWED_IMAGE_HOSTS=
