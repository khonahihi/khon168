#!name=KHON168 
#!desc=Locket Custom Captions by Khon
# Original Source: NightmarketServer
# Credits: NightmarketServer & Duy Vinh
# Customized by: Khon
# GitHub: https://github.com/khonahihi/khon168

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# ~ KHON168 - Locket Custom

# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/khonahihi/khon168/main/js/locketfix.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/khonahihi/khon168/main/js/header.js, timeout=60

# Locket Firebase Remote Config & Custom Captions
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/khonahihi/khon168/main/js/forceGold.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
