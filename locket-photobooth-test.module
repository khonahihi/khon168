#!name=KHON168 Photobooth Test (Camera → Filter)
#!desc=Nhóm khung Photobooth có sẵn trong bộ chọn của Locket. Giữ Custom Captions KHON168.

[Script]
khon168_photobooth = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/khonahihi/khon168/refs/heads/feature/khon168-photobooth/js/forceGold.js, requires-body=true, max-size=2097152, timeout=5

[MITM]
hostname = %APPEND%, firebaseremoteconfig.googleapis.com
