
#!name=KHON168 Photobooth Test
#!desc=KHON168 Custom Captions + Photobooth Camera Filter

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/khonahihi/khon168/feature/khon168-photobooth/js/locketfix.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/khonahihi/khon168/feature/khon168-photobooth/js/header.js, timeout=60

# Firebase Remote Config + Photobooth
khon168_photobooth = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/khonahihi/khon168/feature/khon168-photobooth/js/forceGold.js, requires-body=true, max-size=2097152, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
